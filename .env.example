# Paths
DATA_DIR=./data
MODELS_DIR=./models
CACHE_DIR=./models/cache
BINA_MODEL_DIR=./models/bina-0.2
BINA_RIZEH_MODEL_DIR=./models/bina-0.2-rizeh
BINA_KOOCHIK_MODEL_DIR=./models/bina-0.4-koochik
HF_HOME=./models/cache/huggingface
PADDLE_PDX_CACHE_HOME=./models/cache/paddlex

# Ingestion & Preprocessing
DPI=200
ENABLE_DESKEW=true
ENABLE_DENOISE=false
ENABLE_CONTRAST_NORM=true
USE_NATIVE_PDF_TEXT=false

# Inference & VRAM Constraints (6 GB VRAM Safe Defaults)
DEVICE=gpu
DET_MAX_SIDE_LEN=1280
REC_MODEL_VARIANT=bina-0.2-rizeh
REC_BATCH_SIZE=4
REC_MAX_WH_RATIO=42.0
REC_TARGET_CHUNK_RATIO=32.0
ENABLE_CELL_INK_RECOVERY=true
NEMOTRON_MAX_NEW_TOKENS=1024
ENABLE_TABLES=true
USE_FORMULA_RECOGNITION=false
USE_CHART_RECOGNITION=false
USE_SEAL_RECOGNITION=false
CLEAR_CUDA_CACHE_PER_PAGE=true

# Hybrid Routing (CTC primary + guarded VLM escalation)
HYBRID_CTC_VARIANT=bina-0.2-rizeh
HYBRID_VLM_VARIANT=bina-0.4-koochik
HYBRID_ROUTE_TABLES=true
HYBRID_VLM_MAX_TABLE_ROWS=8
HYBRID_VLM_MAX_TABLE_HEIGHT_PX=550
HYBRID_ROUTE_COMPLEX=true
HYBRID_CTC_CONF_THRESHOLD=0.88

# Optional OpenAI-compatible VLM endpoint (set HYBRID_VLM_VARIANT=openai-vlm)
# VLM_API_BASE_URL=http://localhost:11434/v1
# VLM_API_KEY=
# VLM_MODEL_NAME=qwen2.5vl:7b
# VLM_TIMEOUT_SEC=60.0

# Model Identifiers
LAYOUT_MODEL_NAME=PP-DocLayout_plus-L
DET_MODEL_NAME=PP-OCRv6_medium_det
TABLE_MODEL_NAME=SLANet_plus

# Persian Post-Processing
DIGIT_POLICY=persian
SPELLCHECK_MODE=kenlm
SPELLCHECK_KENLM_PATH=./models/kenlm/persian_5gram_4bit.binary
SPELLCHECK_REAL_WORD_CONF_THRESHOLD=0.94
